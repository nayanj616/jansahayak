# JanSahayak Environment Configuration (Demonstration)
# Copy this file to .env.local and update with your local or test credentials.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Session Security
# Provide a 32+ character random string to sign demonstration session cookies.
# A default fallback is used in development if left empty.
DEMO_SESSION_SECRET=jansahayak_demo_session_secret_key_min_32_characters_for_jwt_signing

# Supabase Integration (Phase 2 Preparation)
# Public variables are accessible in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=placeholder-public-anon-key-for-development

# Server-only administrative key. NEVER expose to the browser!
SUPABASE_SECRET_KEY=placeholder-server-secret-service-role-key

# Google Gemini API Integration (Phase 2 Preparation)
# Server-only key for cleanliness analysis and civic assistant.
GEMINI_API_KEY=placeholder-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

