# JanSahayak Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or real secrets to Git.

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Session Security
# Cryptographically strong 32+ character random string for signing demo cookies.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEMO_SESSION_SECRET=

# Supabase Integration
# Public keys are accessible in browser client bundles.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-Only Administrative Secret Key. NEVER expose to the browser!
SUPABASE_SECRET_KEY=

# Google Gemini API Integration (Phase 4 Preparation)
# Server-only API key for multimodal analysis and conversational assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
