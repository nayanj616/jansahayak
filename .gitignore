# JanSahayak — Git Ignore Configuration

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build & Outputs
/.next/
/out/
/build

# Python Bytecode & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
env/

# Test & Coverage Outputs
/coverage
.nyc_output/

# Environment Configuration
# Strictly exclude all local environment files containing real credentials
.env*
.env.local
.env.*.local
*.env
# Explicitly keep the public template tracked with placeholders only
!.env.example

# Vercel Deployment
.vercel

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts

# Debug & Local Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Temporary Scripts, Scratch & Dumps
tmp/
temp/
scratch/
scripts/temp_*
*.bak
*.tmp

# Editor & IDE Directories
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
